# TryPost staging — copy to ".env.staging" ON THE HOST (never commit the
# filled file; it is covered by the repo's .env* ignore rules).
#
#   cp .env.staging.example .env.staging
#
# Staging-only values: generate FRESH secrets for staging; do not reuse the
# production APP_KEY or DB password. The social client IDs/secrets are the
# one exception — they are the same developer apps as production, and the
# staging redirect URIs must be added in the Meta app and Google client.

STAGING_HOST=staging-trypost.danangdragons.com
VITE_APP_NAME=TryPost Staging

# docker compose -f compose.staging.yaml run --rm app php artisan key:generate --show
APP_KEY=
DB_PASSWORD=
REVERB_APP_KEY=trypost-staging-reverb-key
REVERB_APP_SECRET=

# Leave blank on first boot: the entrypoint generates staging Passport
# keys into the staging storage volume. Fill in only if staging is ever
# recreated without its volume.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Same developer apps as production (values live in the host credential
# file / production .env on Mac 14 — copy them locally, never via chat).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
